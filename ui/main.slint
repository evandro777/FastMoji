import { Button, ComboBox, LineEdit, ListView, Palette, Switch } from "std-widgets.slint";

export struct Cell { img: image, index: int }
// A title row has a non-empty `title`; otherwise it is a row of emoji cells.
export struct Line { title: string, cells: [Cell] }
export struct Category { img: image, label: string }

export component Main inherits Window {
    title: "FastMoji";
    min-width: 356px;
    min-height: 300px;
    preferred-width: 515px;
    preferred-height: 500px;

    in property <[Line]> lines;
    in property <[Category]> categories;
    in property <int> active-category;
    in property <length> cell: 42px;
    in property <length> emoji-px: 28px;
    in property <int> selected-index: -1;
    in property <image> preview-img;
    in property <string> preview-name;
    in property <[image]> chosen;
    in property <string> chosen-more;
    in property <int> tone;
    in property <int> size-choice;
    in property <bool> auto-paste;
    in property <bool> keep-resident;
    in property <bool> resident-locked;
    in property <string> shortcut-label;
    in property <string> shortcut-error;
    in-out property <bool> settings-open;
    in-out property <bool> about-open;
    in property <string> version;
    // Keyboard is on the category bar: Left/Right pick a category, Down/Enter go back to the grid.
    in-out property <bool> categories-focused;
    in-out property <string> search-text;
    in-out property <length> scroll-y <=> list.content-y;
    out property <length> list-height: list.visible-height;

    callback search(string);
    callback width-changed(length);
    callback scrolled();
    callback hovered(int);
    callback picked(int);
    callback appended(int);
    callback category-clicked(int);
    callback move-horizontal(int);
    callback move-vertical(int) -> bool;
    callback accept-selection(bool);
    callback cycle-category(int);
    callback dismiss();
    callback quit();
    callback open-url(string);
    callback set-tone(int);
    callback set-size(int);
    callback set-auto-paste(bool);
    callback set-keep-resident(bool);
    callback record-key(string, bool, bool, bool, bool) -> bool;
    pure callback held-text(bool, bool, bool, bool) -> string;
    in-out property <bool> recording-shortcut;
    // Modifiers currently held while recording, for the live label.
    in-out property <[bool]> held: [false, false, false, false];

    public function focus-search() {
        search-box.focus();
    }

    FocusScope {
        capture-key-pressed(e) => {
            if root.recording-shortcut {
                root.held = [e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta];
                if e.text == Key.Escape || root.record-key(e.text, e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta) {
                    root.recording-shortcut = false;
                }
                return accept;
            }
            if e.text == Key.Escape {
                if root.settings-open { root.settings-open = false; } else { root.dismiss(); }
                return accept;
            }
            if root.settings-open { return reject; }
            if root.categories-focused {
                if e.text == Key.LeftArrow || e.text == Key.RightArrow {
                    root.cycle-category(e.text == Key.LeftArrow ? -1 : 1);
                    return accept;
                }
                if e.text == Key.DownArrow || e.text == Key.Return { root.categories-focused = false; return accept; }
                if e.text == Key.UpArrow { return accept; }
                // Any other key (typing a search, Tab...) leaves the bar.
                root.categories-focused = false;
            }
            if e.text == Key.Return {
                root.accept-selection(e.modifiers.shift);
                return accept;
            }
            if e.text == Key.DownArrow { root.move-vertical(1); return accept; }
            if e.text == Key.UpArrow {
                // Up from the top row reaches the category bar (not while searching: no categories then).
                if !root.move-vertical(-1) && root.search-text == "" { root.categories-focused = true; }
                return accept;
            }
            // Arrows always move through the emoji, even while typing a search.
            if e.text == Key.LeftArrow { root.move-horizontal(-1); return accept; }
            if e.text == Key.RightArrow { root.move-horizontal(1); return accept; }
            if e.modifiers.control && (e.text == "f" || e.text == "F") { search-box.focus(); return accept; }
            if e.modifiers.control && e.text == Key.Tab {
                root.cycle-category(e.modifiers.shift ? -1 : 1);
                return accept;
            }
            if e.text == Key.Backtab { root.cycle-category(-1); return accept; }
            return reject;
        }

        capture-key-released(e) => {
            if root.recording-shortcut {
                // The released modifier may still be set in the event, so clear it by key.
                root.held = [
                    e.modifiers.control && e.text != Key.Control && e.text != Key.ControlR,
                    e.modifiers.alt && e.text != Key.Alt && e.text != Key.AltGr,
                    e.modifiers.shift && e.text != Key.Shift && e.text != Key.ShiftR,
                    e.modifiers.meta && e.text != Key.Meta && e.text != Key.MetaR,
                ];
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            // Category bar
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 8px;
                spacing: 2px;
                for category[i] in root.categories: Rectangle {
                    height: 34px;
                    border-radius: 17px;
                    border-width: root.categories-focused && i == root.active-category ? 2px : 0px;
                    border-color: Palette.accent-background;
                    background: i == root.active-category ? Palette.selection-background.with-alpha(0.35) : (cat-touch.has-hover ? #8883 : transparent);
                    Image {
                        source: category.img;
                        width: 20px;
                        height: 20px;
                        opacity: i == root.active-category ? 1.0 : 0.65;
                    }
                    cat-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.category-clicked(i); }
                    }
                }
            }

            // Search + menu
            HorizontalLayout {
                padding: 12px;
                padding-top: 6px;
                spacing: 8px;
                search-box := LineEdit {
                    placeholder-text: "Search emoji";
                    text <=> root.search-text;
                    edited(text) => { root.search(text); }
                }
                // A plain Button keeps the native hover/pressed look; the icon is drawn on top
                // (a Path takes no input, so clicks reach the button) and follows the theme.
                Rectangle {
                    width: self.height;
                    Button {
                        width: 100%;
                        height: 100%;
                        accessible-label: "Settings";
                        clicked => { root.settings-open = true; }
                    }
                    Path {
                        width: 16px;
                        height: 14px;
                        viewbox-width: 16;
                        viewbox-height: 14;
                        commands: "M 1 1 L 15 1 M 1 7 L 15 7 M 1 13 L 15 13";
                        stroke: Palette.foreground;
                        stroke-width: 2px;
                        stroke-line-cap: round;
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Palette.border;
            }

            list := ListView {
                vertical-stretch: 1;
                changed width => { root.width-changed(self.width); }
                changed content-y => { root.scrolled(); }
                init => { root.width-changed(self.width); }

                for line in root.lines: Rectangle {
                    height: root.cell;
                    if line.title != "": Text {
                        x: 12px;
                        text: line.title;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                        color: Palette.foreground.with-alpha(0.7);
                    }
                    if line.title == "": HorizontalLayout {
                        padding-left: 6px;
                        alignment: start;
                        for e in line.cells: Rectangle {
                            width: root.cell;
                            height: root.cell;
                            border-radius: 8px;
                            background: e.index == root.selected-index ? Palette.selection-background.with-alpha(0.35) : transparent;
                            Image {
                                source: e.img;
                                width: root.emoji-px;
                                height: root.emoji-px;
                            }
                            touch := TouchArea {
                                changed has-hover => {
                                    if self.has-hover { root.hovered(e.index); }
                                }
                                pointer-event(ev) => {
                                    if ev.kind == PointerEventKind.up {
                                        if ev.button == PointerEventButton.left { root.picked(e.index); }
                                        if ev.button == PointerEventButton.right { root.appended(e.index); }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Palette.border;
            }

            // Preview + multi-select strip
            HorizontalLayout {
                padding: 10px;
                spacing: 12px;
                height: 56px;
                Image {
                    source: root.preview-img;
                    width: 36px;
                    height: 36px;
                    y: 0px;
                }
                Text {
                    text: root.preview-name;
                    font-size: 14px;
                    font-weight: 600;
                    overflow: elide;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Text {
                    visible: root.chosen-more != "";
                    text: root.chosen-more;
                    color: Palette.foreground.with-alpha(0.6);
                    vertical-alignment: center;
                }
                for img in root.chosen: Image {
                    source: img;
                    width: 24px;
                    height: 24px;
                }
            }
        }
    }

    if root.settings-open: Rectangle {
        background: #0008;
        TouchArea { clicked => { root.recording-shortcut = false; root.settings-open = false; } }
        Rectangle {
            width: min(root.width - 40px, 340px);
            height: min(root.height - 20px, 345px);
            background: Palette.background;
            border-radius: 10px;
            border-width: 1px;
            border-color: Palette.border;
            TouchArea { }
            VerticalLayout {
                padding: 18px;
                spacing: 14px;
                Text { text: "Preferences"; font-size: 16px; font-weight: 700; }
                HorizontalLayout {
                    spacing: 12px;
                    Text { text: "Skin tone"; vertical-alignment: center; horizontal-stretch: 1; }
                    for c[i] in [#ffc83d, #fadcbc, #e0bb95, #bf8f68, #9b643d, #594539]: Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 12px;
                        background: c;
                        border-width: root.tone == i ? 3px : 1px;
                        border-color: root.tone == i ? Palette.accent-background : Palette.border;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.set-tone(i); }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 12px;
                    Text { text: "Emoji size"; vertical-alignment: center; horizontal-stretch: 1; }
                    ComboBox {
                        model: ["Small (20 px)", "Compact (24 px)", "Default (28 px)", "Large (32 px)", "Extra large (36 px)"];
                        current-index: root.size-choice;
                        selected => { root.set-size(self.current-index); }
                    }
                }
                HorizontalLayout {
                    spacing: 12px;
                    Text { text: "Automatic paste"; vertical-alignment: center; horizontal-stretch: 1; }
                    Switch {
                        checked: root.auto-paste;
                        toggled => { root.set-auto-paste(self.checked); }
                    }
                }
                HorizontalLayout {
                    spacing: 12px;
                    Text { text: "Keep FastMoji in memory"; vertical-alignment: center; horizontal-stretch: 1; }
                    Switch {
                        checked: root.keep-resident;
                        enabled: !root.resident-locked;
                        toggled => { root.set-keep-resident(self.checked); }
                    }
                }
                HorizontalLayout {
                    spacing: 12px;
                    Text { text: "Shortcut"; vertical-alignment: center; horizontal-stretch: 1; }
                    Button {
                        width: 190px;
                        text: root.recording-shortcut ? root.held-text(root.held[0], root.held[1], root.held[2], root.held[3]) : root.shortcut-label;
                        enabled: root.keep-resident;
                        clicked => { root.held = [false, false, false, false]; root.recording-shortcut = true; }
                    }
                }
                Text {
                    wrap: word-wrap;
                    font-size: 11px;
                    color: root.keep-resident && root.shortcut-error == "" ? Palette.foreground.with-alpha(0.6) : #e5a50a;
                    text: root.resident-locked ? "Always on in this session (the clipboard needs it)."
                        : (root.keep-resident ? (root.shortcut-error != "" ? root.shortcut-error : "Required for the " + root.shortcut-label + " shortcut. Opens instantly and uses a little memory.")
                        : "Warning: " + root.shortcut-label + " is disabled while this is off. Open FastMoji with your own shortcut that runs `fastmoji`.");
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Button { text: "Quit FastMoji"; clicked => { root.quit(); } }
                    Button { text: "About"; clicked => { root.about-open = true; } }
                    Button { text: "Close"; primary: true; clicked => { root.recording-shortcut = false; root.settings-open = false; } }
                }
            }
        }
    }

    if root.about-open: Rectangle {
        background: #0008;
        TouchArea { clicked => { root.about-open = false; } }
        Rectangle {
            width: min(root.width - 40px, 320px);
            height: min(root.height - 20px, 250px);
            background: Palette.background;
            border-radius: 10px;
            border-width: 1px;
            border-color: Palette.border;
            TouchArea { }
            VerticalLayout {
                padding: 18px;
                spacing: 8px;
                alignment: center;
                Text { text: "FastMoji"; font-size: 20px; font-weight: 700; horizontal-alignment: center; }
                Text { text: "Version " + root.version; horizontal-alignment: center; }
                Text { text: "Light and fast emoji picker for Linux."; horizontal-alignment: center; wrap: word-wrap; }
                Text { text: "Author: evandro777"; horizontal-alignment: center; }
                Text { text: "License: GPL-3.0-or-later"; horizontal-alignment: center; }
                Text {
                    text: "github.com/evandro777/FastMoji";
                    horizontal-alignment: center;
                    color: #3584e4;
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.open-url("https://github.com/evandro777/FastMoji"); }
                    }
                }
                Button { text: "Close"; primary: true; clicked => { root.about-open = false; } }
            }
        }
    }
}
