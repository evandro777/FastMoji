import { Button, ComboBox, ListView, Palette, Switch } from "std-widgets.slint";
import { Family } from "family.slint";
import { AboutCard, PrefRow } from "about.slint";
import { MenuButton, SearchBox } from "controls.slint";

export struct Cell { img: image, index: int }
// A title row has a non-empty `title`; otherwise it is a row of emoji cells.
export struct Line { title: string, cells: [Cell] }
export struct Category { img: image, label: string }

// Strings built in Rust go through here so they are translated like the ones in the UI.
export global Tr {
    public pure function category(i: int) -> string {
        if i == 0 { return @tr("Recently Used"); }
        if i == 1 { return @tr("Smileys & People"); }
        if i == 2 { return @tr("Animals & Nature"); }
        if i == 3 { return @tr("Food & Drink"); }
        if i == 4 { return @tr("Activities"); }
        if i == 5 { return @tr("Travel & Places"); }
        if i == 6 { return @tr("Objects"); }
        if i == 7 { return @tr("Symbols"); }
        return @tr("Flags");
    }
    public pure function no-matches(query: string) -> string { return @tr("No matches for “{}”", query); }
    public pure function results(query: string) -> string { return @tr("Results for “{}”", query); }
    public pure function shortcut-unavailable(error: string) -> string { return @tr("Shortcut unavailable: {}", error); }
    public pure function shortcut-taken(shortcut: string) -> string { return @tr("{} is already used by another application.", shortcut); }
    public pure function press-keys() -> string { return @tr("Press keys… (Esc cancels)"); }
    public pure function cannot-parse(text: string) -> string { return @tr("Cannot parse {}. Example: Ctrl+Alt+.", text); }
}

export component Main inherits Window {
    title: "FastMoji";
    min-width: 356px;
    min-height: 300px;
    preferred-width: 515px;
    preferred-height: 500px;

    in property <[Line]> lines;
    in property <[Category]> categories;
    in property <int> active-category;
    in property <length> cell: 42px;
    in property <length> emoji-px: 28px;
    in property <int> selected-index: -1;
    in property <image> preview-img;
    in property <string> preview-name;
    in property <int> tone;
    in property <int> size-choice;
    in property <int> language-choice;
    // 0 follows the system, 1 light, 2 dark (settings.theme). Palette.color-scheme is the only palette property an app
    // can set; the colors still follow the system accent.
    in property <int> theme-choice;
    changed theme-choice => {
        Palette.color-scheme = root.theme-choice == 1 ? ColorScheme.light
            : root.theme-choice == 2 ? ColorScheme.dark : ColorScheme.unknown;
    }
    in property <bool> auto-paste;
    in property <bool> keep-resident;
    in property <bool> resident-locked;
    in property <string> shortcut-label;
    in property <string> shortcut-error;
    in-out property <bool> settings-open;
    in-out property <bool> about-open;
    in property <string> version;
    // Keyboard is on the category bar: Left/Right pick a category, Down/Enter go back to the grid.
    in-out property <bool> categories-focused;
    in-out property <string> search-text;
    in-out property <length> scroll-y <=> list.content-y;
    out property <length> list-height: list.visible-height;

    callback search(string);
    callback width-changed(length);
    callback scrolled();
    callback hovered(int);
    callback picked(int);
    callback category-clicked(int);
    callback move-horizontal(int);
    callback move-vertical(int) -> bool;
    callback move-page(int);
    callback accept-selection();
    callback cycle-category(int);
    callback dismiss();
    callback quit();
    callback open-url(string);
    callback set-tone(int);
    callback set-size(int);
    callback set-language(int);
    callback set-theme(int);
    callback set-auto-paste(bool);
    callback set-keep-resident(bool);
    callback record-key(string, bool, bool, bool, bool) -> bool;
    pure callback held-text(bool, bool, bool, bool) -> string;
    in-out property <bool> recording-shortcut;
    // Modifiers currently held while recording, for the live label.
    in-out property <[bool]> held: [false, false, false, false];

    public function focus-search() {
        search-box.focus();
    }

    FocusScope {
        capture-key-pressed(e) => {
            if root.recording-shortcut {
                root.held = [e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta];
                if e.text == Key.Escape || root.record-key(e.text, e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta) {
                    root.recording-shortcut = false;
                }
                return accept;
            }
            if e.text == Key.Escape {
                if root.settings-open { root.settings-open = false; }
                else if root.search-text != "" { root.search-text = ""; root.search(""); }
                else { root.dismiss(); }
                return accept;
            }
            if root.settings-open { return reject; }
            if root.categories-focused {
                if e.text == Key.LeftArrow || e.text == Key.RightArrow {
                    root.cycle-category(e.text == Key.LeftArrow ? -1 : 1);
                    return accept;
                }
                if e.text == Key.DownArrow || e.text == Key.Return { root.categories-focused = false; return accept; }
                if e.text == Key.UpArrow { return accept; }
                // Any other key (typing a search, Tab...) leaves the bar.
                root.categories-focused = false;
            }
            if e.text == Key.Return {
                root.accept-selection();
                return accept;
            }
            if e.text == Key.PageDown { root.move-page(1); return accept; }
            if e.text == Key.PageUp { root.move-page(-1); return accept; }
            if e.text == Key.DownArrow { root.move-vertical(1); return accept; }
            if e.text == Key.UpArrow {
                // Up from the top row reaches the category bar (not while searching: no categories then).
                if !root.move-vertical(-1) && root.search-text == "" { root.categories-focused = true; }
                return accept;
            }
            // Arrows always move through the emoji, even while typing a search.
            if e.text == Key.LeftArrow { root.move-horizontal(-1); return accept; }
            if e.text == Key.RightArrow { root.move-horizontal(1); return accept; }
            if e.modifiers.control && (e.text == "f" || e.text == "F") { search-box.focus(); return accept; }
            if e.modifiers.control && e.text == Key.Tab {
                root.cycle-category(e.modifiers.shift ? -1 : 1);
                return accept;
            }
            if e.text == Key.Backtab { root.cycle-category(-1); return accept; }
            return reject;
        }

        capture-key-released(e) => {
            if root.recording-shortcut {
                // The released modifier may still be set in the event, so clear it by key.
                root.held = [
                    e.modifiers.control && e.text != Key.Control && e.text != Key.ControlR,
                    e.modifiers.alt && e.text != Key.Alt && e.text != Key.AltGr,
                    e.modifiers.shift && e.text != Key.Shift && e.text != Key.ShiftR,
                    e.modifiers.meta && e.text != Key.Meta && e.text != Key.MetaR,
                ];
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            // Category bar
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 8px;
                spacing: 2px;
                for category[i] in root.categories: Rectangle {
                    height: 34px;
                    // Fixed-size chip centered in a stretching slot, so it looks the same at any width.
                    Rectangle {
                        width: 40px;
                        height: 32px;
                        border-radius: 8px;
                        border-width: root.categories-focused && i == root.active-category ? 2px : 0px;
                        border-color: Palette.accent-background;
                        background: i == root.active-category ? Family.selected : (cat-touch.has-hover ? Palette.foreground.with-alpha(0.08) : transparent);
                        Image {
                            source: category.img;
                            width: 20px;
                            height: 20px;
                            opacity: i == root.active-category || cat-touch.has-hover ? 1.0 : 0.6;
                        }
                    }
                    cat-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.category-clicked(i); }
                    }
                }
            }

            // Search + menu
            HorizontalLayout {
                padding: 12px;
                padding-top: 6px;
                spacing: 8px;
                search-box := SearchBox {
                    placeholder: @tr("Search emoji");
                    text <=> root.search-text;
                    edited(text) => { root.search(text); }
                }
                Rectangle {
                    width: self.height;
                    MenuButton {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        label: @tr("Preferences");
                        clicked => { root.settings-open = true; }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Palette.border;
            }

            list := ListView {
                vertical-stretch: 1;
                changed width => { root.width-changed(self.width); }
                changed content-y => { root.scrolled(); }
                init => { root.width-changed(self.width); }

                for line in root.lines: Rectangle {
                    height: root.cell;
                    if line.title != "": Text {
                        x: 12px;
                        text: line.title;
                        font-size: Family.body;
                        font-weight: Family.section-weight;
                        vertical-alignment: center;
                        color: Family.muted;
                    }
                    if line.title == "": HorizontalLayout {
                        padding-left: 6px;
                        alignment: start;
                        for e in line.cells: Rectangle {
                            width: root.cell;
                            height: root.cell;
                            border-radius: 8px;
                            background: e.index == root.selected-index ? Family.selected : transparent;
                            Image {
                                source: e.img;
                                width: root.emoji-px;
                                height: root.emoji-px;
                            }
                            touch := TouchArea {
                                pointer-event(ev) => {
                                    // Only real pointer motion selects: has-hover also fires when the window opens under a still pointer.
                                    if ev.kind == PointerEventKind.move { root.hovered(e.index); }
                                    if ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left { root.picked(e.index); }
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Palette.border;
            }

            // Preview
            HorizontalLayout {
                padding: 10px;
                spacing: 12px;
                height: 56px;
                Image {
                    source: root.preview-img;
                    width: 36px;
                    height: 36px;
                    y: 0px;
                }
                Text {
                    text: root.preview-name;
                    font-size: Family.body;
                    font-weight: Family.section-weight;
                    overflow: elide;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
        }
    }

    if root.settings-open: Rectangle {
        background: Family.scrim;
        TouchArea { clicked => { root.recording-shortcut = false; root.settings-open = false; } }
        Rectangle {
            width: min(root.width - 40px, Family.dialog-width);
            height: min(root.height - 20px, prefs-layout.preferred-height);
            background: Palette.background;
            border-radius: Family.radius;
            border-width: 1px;
            border-color: Palette.border;
            TouchArea { }
            prefs-layout := VerticalLayout {
                padding: 16px;
                spacing: Family.gap-l;
                Text { text: @tr("Preferences"); font-size: Family.page-title; font-weight: Family.page-weight; }
                PrefRow {
                    label: @tr("Appearance");
                    ComboBox {
                        width: Family.control-width;
                        model: [@tr("System"), @tr("Light"), @tr("Dark")];
                        current-index: root.theme-choice;
                        selected => { root.set-theme(self.current-index); }
                    }
                }
                PrefRow {
                    label: @tr("Language");
                    ComboBox {
                        width: Family.control-width;
                        model: [@tr("System"), "English", "Português (Brasil)", "Français", "Deutsch", "Español", "Italiano", "日本語", "中文"];
                        current-index: root.language-choice;
                        selected => { root.set-language(self.current-index); }
                    }
                }
                PrefRow {
                    label: @tr("Skin tone");
                    for c[i] in [#ffc83d, #fadcbc, #e0bb95, #bf8f68, #9b643d, #594539]: Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 12px;
                        background: c;
                        border-width: root.tone == i ? 2px : 1px;
                        border-color: root.tone == i ? Palette.accent-background : Palette.border;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.set-tone(i); }
                        }
                    }
                }
                PrefRow {
                    label: @tr("Emoji size");
                    ComboBox {
                        width: Family.control-width;
                        model: [@tr("Small ({} px)", 20), @tr("Compact ({} px)", 24), @tr("Default ({} px)", 28), @tr("Large ({} px)", 32), @tr("Extra large ({} px)", 36)];
                        current-index: root.size-choice;
                        selected => { root.set-size(self.current-index); }
                    }
                }
                PrefRow {
                    label: @tr("Automatic paste");
                    Switch {
                        checked: root.auto-paste;
                        toggled => { root.set-auto-paste(self.checked); }
                    }
                }
                PrefRow {
                    label: @tr("Keep FastMoji in memory");
                    Switch {
                        checked: root.keep-resident;
                        enabled: !root.resident-locked;
                        toggled => { root.set-keep-resident(self.checked); }
                    }
                }
                PrefRow {
                    label: @tr("Shortcut");
                    Button {
                        width: Family.control-width;
                        text: root.recording-shortcut ? root.held-text(root.held[0], root.held[1], root.held[2], root.held[3]) : root.shortcut-label;
                        enabled: root.keep-resident;
                        clicked => { root.held = [false, false, false, false]; root.recording-shortcut = true; }
                    }
                }
                Text {
                    wrap: word-wrap;
                    font-size: Family.caption;
                    color: root.keep-resident && root.shortcut-error == "" ? Family.muted : Family.warning;
                    text: root.resident-locked ? @tr("Always on in this session (the clipboard needs it).")
                        : (root.keep-resident ? (root.shortcut-error != "" ? root.shortcut-error : @tr("Required for the {} shortcut. Opens instantly and uses a little memory.", root.shortcut-label))
                        : @tr("Warning: {} is disabled while this is off. Open FastMoji with your own shortcut that runs `fastmoji`.", root.shortcut-label));
                }
                HorizontalLayout {
                    spacing: 8px;
                    Button { text: @tr("Quit FastMoji"); clicked => { root.quit(); } }
                    Button { text: @tr("About"); clicked => { root.about-open = true; } }
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: @tr("Close"); primary: true; clicked => { root.recording-shortcut = false; root.settings-open = false; } }
                }
            }
        }
    }

    if root.about-open: Rectangle {
        background: Family.scrim;
        TouchArea { clicked => { root.about-open = false; } }
        Rectangle {
            width: min(root.width - 40px, Family.dialog-width);
            height: min(root.height - 20px, about-layout.preferred-height);
            background: Palette.background;
            border-radius: Family.radius;
            border-width: 1px;
            border-color: Palette.border;
            TouchArea { }
            about-layout := VerticalLayout {
                padding: 16px;
                AboutCard {
                    icon: @image-url("../flatpak/io.github.evandro777.FastMoji.svg");
                    name: "FastMoji";
                    version: root.version;
                    description: @tr("Light and fast emoji picker for Linux.");
                    url: "github.com/evandro777/FastMoji";
                    link-clicked(u) => { root.open-url(u); }
                    close => { root.about-open = false; }
                }
            }
        }
    }
}
